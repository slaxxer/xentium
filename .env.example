# Copy to .env (repo root) and fill in the secrets below.
# Validated by Zod at startup (apps/api/src/config/env.ts) — the app won't boot
# with an invalid config. See the README for how to generate the secrets.

# ── Infrastructure (defaults match docker/docker-compose.yml) ──────────────────
DATABASE_URL="postgresql://nodevo:nodevo@localhost:5432/nodevo"
REDIS_URL="redis://localhost:6379"
APP_URL="http://localhost:5173"

# ── Required secrets ───────────────────────────────────────────────────────────
# COOKIE_SECRET     >=16 chars  ->  openssl rand -hex 16
# JWT_SECRET        >=32 chars  ->  openssl rand -hex 32
# DUMMY_ARGON2_HASH any argon2 hash ->
#   pnpm --filter @nodevo/api exec node --input-type=commonjs \
#     -e "require('argon2').hash('nodevo-dummy').then(h=>console.log(h))"
COOKIE_SECRET=""
JWT_SECRET=""
DUMMY_ARGON2_HASH=""

# ── Optional (sensible defaults shown) ─────────────────────────────────────────
# PORT=4000
# NODE_ENV defaults to production — every instance runs hardened unless a
# developer explicitly opts into development here (or via ./xentium.sh).
# NODE_ENV=development
# UPLOAD_DIR=./var/uploads
# REDIS_KEY_PREFIX=nodevo:
# BOOTSTRAP_OFFICIAL_PLUGINS=false
