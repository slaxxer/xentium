    "@xentium/errors": "workspace:*",
    "@xentium/plugin-engine": "workspace:*",
    "@xentium/plugin-sdk": "workspace:*",
    "@xentium/sdk": "workspace:*",
    "@xentium/server-kit": "workspace:*",
    "adm-zip": "^0.6.0",
    "argon2": "catalog:",
    "bcryptjs": "^3.0.3",
    "bullmq": "catalog:",
    "cookie-parser": "catalog:",
    "cors": "catalog:",
    "cron-parser": "^4.9.0",
    "dotenv": "^17.4.2",
    "express": "catalog:",
