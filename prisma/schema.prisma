generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// Phase 0–3 (existing)
// ============================================

// One row per migration run (§34): core schema deploys (adapter = "core",
// written by the installer/runMigrations) AND platform-migration CLI runs
// (adapter = "wordpress" | "xenforo" | …, written by @xentium/migrate).
model MigrationRun {
  id          String    @id @default(uuid())
  adapter     String    @default("core")
  adapterVer  String?   @map("adapter_ver")
  sourceInfo  String?   @map("source_info") // e.g. "XenForo 2.2.14"
  status      String    @default("completed") // running | completed | partial | failed
  command     String?
  durationMs  Int?
  output      String?   @db.Text
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  summary     Json?     // { users: 1240, threads: 8904, posts: 44320, ... }
  errors      Json?     // [{ entity, sourceId, reason }, ...]
  reportPath  String?   @map("report_path")
  createdAt   DateTime  @default(now())

  @@map("ncf_migration_runs")
}

// Source-entity → Xentium-entity mapping written during platform migrations.
// Makes re-runs resumable/idempotent (skip already-imported source ids) and
// lets adapters resolve cross-references (post → author) mid-run.
model ImportMapEntry {
  id        String   @id @default(uuid())
  runId     String?  @map("run_id")
  platform  String // "wordpress" | "xenforo" | "phpbb" | ...
  entity    String // "user" | "article" | "comment" | "category" | "thread" | "post" | "attachment"
  sourceId  String   @map("source_id")
  xentiumId  String   @map("nodevo_id")
  createdAt DateTime @default(now())

  @@unique([platform, entity, sourceId])
  @@index([xentiumId])
  @@map("ncf_import_map")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  // "argon2" (native) or a legacy scheme set by migration adapters
  // ("bcrypt", "phpass"). Non-argon2 hashes are verified with the legacy
  // algorithm on login, then transparently rehashed to argon2 (§17b intent:
  // migrated users keep their password, no forced reset).
  passwordScheme String @default("argon2") @map("password_scheme")
  displayName  String?  @map("display_name")
  bio          String?  @db.Text
  avatar       String?
  isActive     Boolean   @default(true)
  bannedUntil  DateTime? @map("banned_until")

  postCount          Int      @default(0) @map("post_count")     // forum-populated (forum plugin)
  threadCount        Int      @default(0) @map("thread_count")    // forum-populated (forum plugin)
  articleCount       Int      @default(0) @map("article_count")
  commentCount       Int      @default(0) @map("comment_count")   // article comments authored (progression)
  likeCountReceived  Int      @default(0) @map("like_count_received")
  followerCount      Int      @default(0) @map("follower_count")
  followingCount     Int      @default(0) @map("following_count")
  usernameChangedAt  DateTime? @map("username_changed_at")
  emailVerifiedAt    DateTime? @map("email_verified_at")
  loginPinEnabled    Boolean   @default(false) @map("login_pin_enabled")
  loginPinHash       String?   @map("login_pin_hash")
  dobDisplay         String    @default("age") @map("dob_display")  // 'hidden' | 'age' | 'date'
  preferredLocale    String?   @map("preferred_locale")  // null = follow resolution chain (§60.4)
  hiddenBadges       String[]  @default([]) @map("hidden_badges")  // Group IDs the user hides from their badge stack, systemwide
  /// The member's own cover image, relative ("covers/<id>.jpg"). Distinct from the
  /// `profileCover` BLOCK's background, which an admin sets for every profile — this
  /// one is personal and wins over it.
  coverImage         String?   @map("cover_image")
  /// All-time profile views, GUESTS INCLUDED — deduped per IP the way articles are.
  /// Deliberately not `count(ncf_profile_views)`: that table holds only named
  /// visitors and is pruned, so counting it would make the total shrink over time.
  profileViewCount   Int       @default(0) @map("profile_view_count")

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  groups   UserGroup[]
  sessions Session[]
  emailChangeTokens EmailChangeToken[]
  passwordResetTokens PasswordResetToken[]

  profileComments         ProfileComment[] @relation("ProfileCommentOwner")
  authoredProfileComments ProfileComment[] @relation("ProfileCommentAuthor")

  following   UserFollow[] @relation("UserFollower")
  followers   UserFollow[] @relation("UserFollowing")
  blocking    UserBlock[]  @relation("UserBlocker")
  blockedBy   UserBlock[]  @relation("UserBlocked")

  articles            Article[]            @relation("ArticleAuthor")
  pages               Page[]               @relation("PageCreatedBy")
  articleRevisions    ArticleRevision[]    @relation("RevisionAuthor")
  articleLikes        ArticleLike[]        @relation("ArticleLikedBy")
  articleDislikes     ArticleDislike[]     @relation("ArticleDislikedBy")
  articleComments          ArticleComment[]     @relation("ArticleCommentAuthor")
  articleCommentsDeleted   ArticleComment[]     @relation("ArticleCommentDeletedBy")
  articleCommentLikes      ArticleCommentLike[] @relation("ArticleCommentLikedBy")
  profileCommentLikes          ProfileCommentLike[] @relation("ProfileCommentLikedBy")
  profileCommentsDeleted       ProfileComment[]     @relation("ProfileCommentDeletedBy")

  // Moderation (back-relations for Phase 6 models)
  reportsFiled     ModerationReport[]  @relation("ReportFiled")
  reportsAgainst   ModerationReport[]  @relation("ReportAgainst")
  warningsReceived ModerationWarning[] @relation("WarningReceived")
  warningsIssued   ModerationWarning[] @relation("WarningIssued")
  bansReceived     ModerationBan[]     @relation("BanReceived")
  bansIssued       ModerationBan[]     @relation("BanIssued")
  styleHistories   StyleHistory[]
  invitesCreated   InviteCode[]    @relation("InviteCreated")
  invitesUsed      InviteCode[]    @relation("InviteUsed")
  badges           UserBadge[]
  profileViews     ProfileView[] @relation("ProfileViewed")
  profileViewsMade ProfileView[] @relation("ProfileViewer")

  @@map("ncf_users")
}

model Group {
  id           String   @id @default(uuid())
  key          String   @unique
  name         String
  icon         String?
  isSystem     Boolean  @default(false)
  displayOrder Int      @default(100) @map("display_order")  // badge precedence; lower = higher priority
  showInTeam   Boolean  @default(false) @map("show_in_team")  // surface this group as a section on the Team page
  createdAt    DateTime @default(now())

  users       UserGroup[]
  permissions GroupPermission[]
  progression GroupProgression?

  @@map("ncf_groups")
}

// ── Phase 7 — Progression system (§38) ───────────────────────────────────────

model GroupProgression {
  groupId                  String   @id @map("group_id")
  group                    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  isProgressionGroup       Boolean  @default(false) @map("is_progression_group")
  ladderPosition           Int?     @map("ladder_position")
  promoteFromGroupId       String?  @map("promote_from_group_id")

  // Core thresholds (article-CMS) — all ANDed unless progression.threshold_logic = "or".
  // Forum thresholds (min posts/threads) are contributed by the forum plugin via
  // registerProgressionCriteria, not stored here (§38 core/plugin split).
  minArticles              Int?     @map("min_articles")
  minComments              Int?     @map("min_comments")
  minDaysMember            Int?     @map("min_days_member")
  minLikesReceived         Int?     @map("min_likes_received")

  // Core content limits (enforced by Phase 7 middleware). Forum post limits live
  // in the forum plugin. null = unlimited, on all four.
  maxArticleLength         Int?     @map("max_article_length")
  maxDailyArticles         Int?     @map("max_daily_articles")
  maxCommentLength         Int?     @map("max_comment_length")
  maxDailyComments         Int?     @map("max_daily_comments")
  maxAttachments           Int?     @map("max_attachments")       // reserved for Phase 14+

  // Profile image limits (§38). Apply to BOTH the avatar and the cover.
  // ⚠ Stored since Phase 7 and enforced nowhere until 2026-09-10 — an admin could
  // set them and nothing read them. `assertProfileImageAllowed` is now the one
  // chokepoint both upload routes go through.
  maxProfileImageBytes     Int?     @map("max_profile_image_bytes")
  /// MIME types this rung may upload. EMPTY = no per-rank restriction; the global
  /// `UPLOAD_LIMITS` ceiling still applies. Putting `image/gif` here at a senior
  /// rung is what "animated cover images unlock at Veteran" means.
  allowedProfileImageTypes String[] @default([]) @map("allowed_profile_image_types")
  /// Whether this rung may set a cover image at all.
  /// ⚠ Defaults TRUE: covers did not exist before this flag, so defaulting false
  /// would silently withhold a new feature from every existing group.
  canUploadCover           Boolean  @default(true) @map("can_upload_cover")

  // Badge
  badgeLabel               String?  @map("badge_label")
  badgeColor               String?  @map("badge_color")
  // When true, usernames in this group render with a text-shadow "glow" everywhere
  // the name shows — makes staff/special members stand out. Admin-controlled.
  // The glow's colour and offsets are fully configurable (ACP → Progression → Badge):
  // badgeShadowColor null falls back to the badge colour; X/Y/blur are px.
  badgeTextShadow          Boolean  @default(false) @map("badge_text_shadow")
  badgeShadowColor         String?  @map("badge_shadow_color")
  badgeShadowX             Int      @default(1)  @map("badge_shadow_x")
  badgeShadowY             Int      @default(1)  @map("badge_shadow_y")
  badgeShadowBlur          Int      @default(20) @map("badge_shadow_blur")

  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt      @map("updated_at")

  @@index([isProgressionGroup, ladderPosition])
  @@map("ncf_group_progression")
}

// ── Badges (§badges, ADR-0009) — awards an admin grants ──────────────────────
//
// A THIRD thing called a badge, and deliberately not the other two: a GROUP badge
// is membership rendered as a pill (Group.displayOrder, User.hiddenBadges), and a
// RANK badge is the ladder rung's label (GroupProgression.badgeLabel). This one is
// an award — granted by hand, held by a user, and never derived from anything.

model Badge {
  id          String  @id @default(uuid())
  /// Stable identifier for seeds, themes and plugins. The name is editable; this is not.
  key         String  @unique
  name        String
  description String?

  /// FontAwesome icon name (e.g. "faStar"), tinted with `color`.
  faIcon      String? @map("fa_icon")
  /// Tint for the glyph and the pill. Null falls back to the accent token.
  color       String?

  /// Badge precedence on a card; lower sorts first. Same convention as Group.
  displayOrder Int     @default(100) @map("display_order")
  isSystem     Boolean @default(false) @map("is_system")

  /// Whether this badge is EARNED against thresholds, or purely given by hand.
  /// ⚠ Off by default: a badge an admin creates is a badge an admin hands out, and
  /// switching this on for every new badge would make the give-away case — the
  /// simpler and commoner one — the harder one to reach.
  autoAward Boolean @default(false) @map("auto_award")

  /// The thresholds, when `autoAward` is on: `{ "articles": 10, "forum.posts": 50 }`.
  /// ⚠ JSON rather than columns because the keys are EXTENSIBLE — a plugin
  /// contributes its own metrics (the forum's posts and threads) and core cannot
  /// have a column for something it has never heard of. Keys come from the badge
  /// criteria registry; a key whose plugin is gone is simply not evaluated.
  /// ⚠ ALL thresholds must be met, not any: a list of requirements reads that way.
  criteria Json @default("{}")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  users UserBadge[]

  @@map("ncf_badges")
}

model UserBadge {
  userId      String   @map("user_id")
  badgeId     String   @map("badge_id")
  user        User     @relation(fields: [userId],  references: [id], onDelete: Cascade)
  badge       Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  awardedAt   DateTime @default(now()) @map("awarded_at")
  /// Granted by the reward sweep rather than by a person.
  /// ⚠ Never taken back automatically. Earning it was a fact about a moment; undoing
  /// it because a like was deleted would punish a member for someone else's action.
  auto        Boolean  @default(false)
  /// Who granted it. Null once that admin is deleted — the award outlives them.
  awardedById String?  @map("awarded_by_id")
  /// Why, in the admin's words. Shown on the badge's tooltip when present.
  note        String?

  /// A badge is HELD, not accumulated: granting one twice is the same badge.
  @@id([userId, badgeId])
  @@index([badgeId])
  @@map("ncf_user_badges")
}

// ── Profile views (§profile-visitors) ────────────────────────────────────────
//
// Who looked at whose profile. One row PER PAIR, refreshed on a revisit rather
// than appended to — the card shows "who has been here lately", and a row per page
// load would make that a list of one person who refreshed.
//
// ⚠ Only a logged-in, non-owner visit writes a row. A guest has no identity to
// record, so a guest bumps `User.profileViewCount` and nothing else, and looking at
// your own profile counts as neither.

model ProfileView {
  /// Whose profile was looked at.
  profileId String   @map("profile_id")
  /// Who looked.
  viewerId  String   @map("viewer_id")
  profile   User     @relation("ProfileViewed",  fields: [profileId], references: [id], onDelete: Cascade)
  viewer    User     @relation("ProfileViewer",  fields: [viewerId],  references: [id], onDelete: Cascade)

  /// The LAST time they looked, not the first — the card is ordered by it.
  viewedAt  DateTime @default(now()) @map("viewed_at")
  /// How many separate visits, for a site that wants to say "seen 12 times".
  visits    Int      @default(1)

  @@id([profileId, viewerId])
  /// The card's only query: this profile's visitors, most recent first.
  @@index([profileId, viewedAt(sort: Desc)])
  @@map("ncf_profile_views")
}

model Permission {
  id     String            @id @default(uuid())
  key    String            @unique
  label  String
  groups GroupPermission[]

  @@map("ncf_permissions")
}

model UserGroup {
  userId  String
  groupId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])

  @@map("ncf_user_groups")
}

model GroupPermission {
  groupId      String
  permissionId String
  group        Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([groupId, permissionId])

  @@map("ncf_group_permissions")
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String    @unique
  ip               String?
  userAgent        String?
  deviceCookieId   String?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  // The log-retention prune scans by last activity. This is the fastest-growing
  // table in the schema (a row per refresh-token rotation), so the daily prune
  // must not seq-scan it.
  @@index([lastUsedAt])

  @@map("ncf_sessions")
}

model LoginEvent {
  id             String   @id @default(uuid())
  userId         String?
  emailAttempted String
  success        Boolean
  eventType      String   @default("login") @map("event_type")  // login | register | password_change
  ip             String?
  userAgent      String?
  deviceCookieId String?
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([ip])
  @@index([deviceCookieId])
  @@index([eventType, createdAt(sort: Desc)])

  @@map("ncf_login_events")
}

/// An installed theme. INSTALLED is not ACTIVE — the same distinction plugins draw
/// (§10/§54), and for the same reason: an admin trying a second theme must not lose
/// the first. Before this table there was one settings key holding one manifest, so
/// importing a theme silently destroyed whatever had been installed before it.
///
/// The row carries the theme's applicable PAYLOAD, not the original `.nvtheme`: the
/// layout documents, tokens and stylesheets exactly as the importer resolved them,
/// with every asset reference already rewritten to this install's upload paths. That
/// is what lets a theme be re-activated later without the package it came from —
/// and it is why uninstalling has to take the assets with it.
model Theme {
  /// The manifest id. Re-importing the same id UPDATES the row (an upgrade), which
  /// is why this is the primary key rather than a generated one.
  id            String   @id
  name          String
  version       String
  vendor        String
  /// The manifest as stored: `screenshot` already repointed at the upload path.
  manifest      Json
  /// `{ documents, tokens, customCss }` — everything `activate` needs to apply it.
  payload       Json
  /// Exactly one row may be true. Enforced in the service, which clears the others
  /// inside the same transaction that sets this one.
  active        Boolean  @default(false)
  installedAt   DateTime @default(now()) @map("installed_at")
  activatedAt   DateTime? @map("activated_at")
  installedById String?  @map("installed_by_id")

  @@index([active])
  @@map("ncf_themes")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("ncf_settings")
}

/// Admin overrides for outbound mail. Defaults ship in code
/// (infrastructure/email/email-templates.ts); a row here replaces one template.
/// No row means "use the shipped default" — which is what Reset restores.
model EmailTemplate {
  key       String   @id
  subject   String
  body      String
  updatedAt DateTime @updatedAt

  @@map("ncf_email_templates")
}

model Install {
  id          String    @id @default(uuid())
  currentStep String    @default("WELCOME")
  completedAt DateTime?
  siteId      String?
  version     String    @default("1")
  createdAt   DateTime  @default(now())

  @@map("ncf_installs")
}

// ============================================
// Phase 4 – User social & profile features
// ============================================

model UsernameHistory {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  oldUsername  String   @map("old_username")
  newUsername  String   @map("new_username")
  changedAt    DateTime @default(now()) @map("changed_at")
  changedById  String   @map("changed_by_id")

  @@index([userId])
  @@map("ncf_username_history")
}

model UserFollow {
  id          String   @id @default(cuid())
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  follower    User @relation("UserFollower",  fields: [followerId],  references: [id], onDelete: Cascade)
  following   User @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("ncf_user_follows")
}

model UserBlock {
  id         String   @id @default(cuid())
  blockerId  String   @map("blocker_id")
  blockedId  String   @map("blocked_id")
  createdAt  DateTime @default(now()) @map("created_at")

  blocker    User @relation("UserBlocker",  fields: [blockerId],  references: [id], onDelete: Cascade)
  blocked    User @relation("UserBlocked",  fields: [blockedId],  references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@map("ncf_user_blocks")
}

model ProfileComment {
  id             String    @id @default(cuid())
  profileUserId  String    @map("profile_user_id")
  authorId       String    @map("author_id")
  body           String    @db.Text
  likeCount      Int       @default(0) @map("like_count")
  deletedAt      DateTime? @map("deleted_at")
  deletedById    String?   @map("deleted_by_id")
  deletedReason  String?   @map("deleted_reason")
  editedAt       DateTime? @map("edited_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  profileUser    User  @relation("ProfileCommentOwner",    fields: [profileUserId], references: [id], onDelete: Cascade)
  author         User  @relation("ProfileCommentAuthor",  fields: [authorId],      references: [id], onDelete: Cascade)
  deletedBy      User? @relation("ProfileCommentDeletedBy", fields: [deletedById], references: [id])
  likes          ProfileCommentLike[]

  @@index([profileUserId, deletedAt, createdAt(sort: Desc)])
  @@map("ncf_profile_comments")
}

model ProfileCommentLike {
  id         String         @id @default(cuid())
  commentId  String         @map("comment_id")
  userId     String         @map("user_id")
  createdAt  DateTime       @default(now()) @map("created_at")

  comment    ProfileComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user       User           @relation("ProfileCommentLikedBy", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@map("ncf_profile_comment_likes")
}

model UserProfileField {
  id                      String   @id @default(cuid())
  key                     String   @unique
  label                   String
  type                    String   // text, date, email, url
  placeholder             String?
  position                Int      @default(0)
  showOnRegistration      Boolean  @default(false) @map("show_on_registration")
  requiredOnRegistration  Boolean  @default(false) @map("required_on_registration")
  showOnProfile           Boolean  @default(true)  @map("show_on_profile")
  dobDisplayFormat        String?  @map("dob_display_format") // age, birthday, full
  isSystem                Boolean  @default(false) @map("is_system")
  createdAt               DateTime @default(now()) @map("created_at")

  @@map("ncf_user_profile_fields")
}

model UserProfileFieldValue {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  fieldId   String   @map("field_id")
  value     String   @db.Text
  privacy   String   @default("public") // public, members, nobody
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, fieldId])
  @@index([userId])
  @@map("ncf_user_profile_field_values")
}

model UserPrivacySettings {
  userId    String   @id @map("user_id")
  settings  Json     @default("{}")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ncf_user_privacy_settings")
}

// Phase 2 — basic NotificationService (DB writes only)
// Email routing + in-app bell UI arrive in Phase 8.

model Notification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  type      String
  title     String
  body      String    @db.Text
  link      String?
  meta      Json?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@map("ncf_notifications")
}

model NotificationPreference {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  typePattern   String   @map("type_pattern")
  inAppEnabled  Boolean  @default(true) @map("in_app_enabled")
  emailEnabled  Boolean  @default(false) @map("email_enabled")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([userId, typePattern])
  @@index([userId])
  @@map("ncf_notification_preferences")
}
// ============================================
// Phase 5 — Article CMS
// ============================================

model ArticleCategory {
  id          String  @id @default(cuid())
  parentId    String? @map("parent_id")
  parent      ArticleCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    ArticleCategory[] @relation("CategoryTree")
  name        String
  slug        String  @unique
  description String? @db.Text
  position    Int     @default(0)

  // Visibility (§39) — mirrors forum_nodes
  visibility          String   @default("public")            // 'public' | 'members' | 'level' | 'groups'
  visibilityGroups    String[] @default([]) @map("visibility_groups")
  visibilityMinLevel  Int?     @map("visibility_min_level")
  hideIfNoAccess      Boolean  @default(true) @map("hide_if_no_access")
  effectiveVisibility String   @default("public") @map("effective_visibility") // precomputed cache

  articles Article[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([parentId, position])
  @@map("ncf_article_categories")
}

model Article {
  id             String           @id @default(cuid())
  authorId       String           @map("author_id")
  author         User             @relation("ArticleAuthor", fields: [authorId], references: [id])
  categoryId     String?          @map("category_id")
  category       ArticleCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  title          String
  slug           String           @unique
  excerpt        String?          @db.Text
  body           Json             // TipTap / ProseMirror JSON — never raw HTML (§17b)
  bodyPlain      String?          @db.Text @map("body_plain") // plain text extracted for search vector
  featuredImage  String?          @map("featured_image")      // storage path
  status         String           @default("draft")           // 'draft' | 'review' | 'published'
  visibility     String           @default("public")          // 'public' | 'members' | 'private'
  seoTitle       String?          @map("seo_title")
  seoDescription String?          @map("seo_description") @db.Text
  publishedAt    DateTime?        @map("published_at")
  deletedAt      DateTime?        @map("deleted_at")
  deletedById    String?          @map("deleted_by_id")
  likeCount      Int              @default(0) @map("like_count")
  dislikeCount   Int              @default(0) @map("dislike_count")
  commentCount   Int              @default(0) @map("comment_count")
  viewCount      Int              @default(0) @map("view_count")

  // search_vector tsvector column managed by raw SQL trigger — not declared here to prevent db push from dropping it

  revisions ArticleRevision[]
  tags      ArticleTag[]
  likes     ArticleLike[]
  dislikes  ArticleDislike[]
  comments  ArticleComment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, publishedAt(sort: Desc)])
  @@index([categoryId, status])
  @@index([authorId, status])
  @@map("ncf_articles")
}

model ArticleRevision {
  id        String   @id @default(cuid())
  articleId String   @map("article_id")
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  authorId  String   @map("author_id")
  author    User     @relation("RevisionAuthor", fields: [authorId], references: [id])
  title     String
  body      Json
  createdAt DateTime @default(now()) @map("created_at")

  @@index([articleId, createdAt(sort: Desc)])
  @@map("ncf_article_revisions")
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique

  articles ArticleTag[]

  @@map("ncf_tags")
}

model ArticleTag {
  articleId String  @map("article_id")
  tagId     String  @map("tag_id")
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
  @@map("ncf_article_tags")
}

model ArticleLike {
  id        String   @id @default(cuid())
  articleId String   @map("article_id")
  userId    String   @map("user_id")
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User     @relation("ArticleLikedBy", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([articleId, userId])
  @@map("ncf_article_likes")
}

model ArticleDislike {
  id        String   @id @default(cuid())
  articleId String   @map("article_id")
  userId    String   @map("user_id")
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User     @relation("ArticleDislikedBy", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([articleId, userId])
  @@map("ncf_article_dislikes")
}

model ArticleComment {
  id            String          @id @default(cuid())
  articleId     String          @map("article_id")
  article       Article         @relation(fields: [articleId], references: [id], onDelete: Cascade)
  authorId      String          @map("author_id")
  author        User            @relation("ArticleCommentAuthor", fields: [authorId], references: [id])
  parentId      String?         @map("parent_id")
  parent        ArticleComment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       ArticleComment[] @relation("CommentReplies")
  body          String          @db.Text
  status        String          @default("published") // 'published' | 'pending' | 'rejected'
  deletedAt     DateTime?       @map("deleted_at")
  deletedById   String?         @map("deleted_by_id")
  deletedBy     User?           @relation("ArticleCommentDeletedBy", fields: [deletedById], references: [id])
  deletedReason String?         @map("deleted_reason")
  editedAt      DateTime?       @map("edited_at")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  likes ArticleCommentLike[]

  @@index([articleId, deletedAt, createdAt(sort: Desc)])
  @@index([parentId])
  @@map("ncf_article_comments")
}

model ArticleCommentLike {
  id        String         @id @default(cuid())
  commentId String         @map("comment_id")
  userId    String         @map("user_id")
  comment   ArticleComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User           @relation("ArticleCommentLikedBy", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now()) @map("created_at")

  @@unique([commentId, userId])
  @@map("ncf_article_comment_likes")
}

model EmailChangeToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  newEmail  String   @map("new_email")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("ncf_email_change_tokens")
}

// Password reset — DB-backed single-use token (§17b). A JWT would stay valid
// after use / after the password changed; a DB token can be invalidated
// immediately. Raw 32-byte token is emailed; only its SHA-256 hash is stored.
model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")  // 15 minutes from creation
  usedAt    DateTime? @map("used_at")     // set on use; subsequent uses rejected
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("ncf_password_reset_tokens")
}

// ============================================
// Phase 6 additions — moderation, plugins, license, error log, style history
// (spec'd for Phase 2 in §49, added here as part of Phase 6 admin work)
// ============================================

model ModerationReport {
  id         String    @id @default(cuid())
  targetType String    @map("target_type")  // article | article_comment | profile_comment | user | plugin-content | <plugin-specific e.g. shoutbox_shout>
  targetId   String    @map("target_id")
  // Author of the reported content, when known — enables Warn/Ban quick actions
  // on the ModCanvas report row without resolving targetId per content type.
  targetUserId String? @map("target_user_id")
  reporterId String    @map("reporter_id")
  assignedTo String?   @map("assigned_to")
  reason     String    @db.Text
  // Text of the reported content captured at filing time, so the report stays
  // reviewable after the content is deleted or pruned (e.g. shoutbox retention).
  contentSnapshot String? @db.Text @map("content_snapshot")
  notes      String?   @db.Text
  status     String    @default("pending")  // pending | reviewed | resolved | dismissed
  createdAt  DateTime  @default(now()) @map("created_at")
  resolvedAt DateTime? @map("resolved_at")
  resolvedBy String?   @map("resolved_by")

  reporter   User  @relation("ReportFiled",   fields: [reporterId],   references: [id], onDelete: Cascade)
  targetUser User? @relation("ReportAgainst", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@map("ncf_moderation_reports")
}

model ModerationWarning {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  issuedById  String    @map("issued_by_id")
  reason      String    @db.Text
  status      String    @default("active")  // active | expired | pardoned
  expiresAt   DateTime? @map("expires_at")
  pardonedAt  DateTime? @map("pardoned_at")
  pardonedBy  String?   @map("pardoned_by")
  createdAt   DateTime  @default(now()) @map("created_at")

  user     User @relation("WarningReceived", fields: [userId],     references: [id], onDelete: Cascade)
  issuedBy User @relation("WarningIssued",   fields: [issuedById], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("ncf_moderation_warnings")
}

model ModerationBan {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  issuedById String    @map("issued_by_id")
  type       String    // temporary | permanent
  reason     String    @db.Text
  status     String    @default("active")   // active | expired | lifted
  expiresAt  DateTime? @map("expires_at")
  liftedAt   DateTime? @map("lifted_at")
  liftedBy   String?   @map("lifted_by")
  createdAt  DateTime  @default(now()) @map("created_at")

  user     User @relation("BanReceived", fields: [userId],     references: [id], onDelete: Cascade)
  issuedBy User @relation("BanIssued",   fields: [issuedById], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("ncf_moderation_bans")
}

model ModerationCase {
  id            String    @id @default(cuid())
  type          String    // rapid_login_attempts | multi_account_suspicion | ban_evasion_suspicion | registration_burst
  severity      String    // low | medium | high
  status        String    @default("open")  // open | reviewed | dismissed
  signals       Json      // array of signal strings
  linkedUserIds String[]  @map("linked_user_ids")
  notes         String?   @db.Text         // free-text mod note (reason for exception etc.)
  reviewedBy    String?   @map("reviewed_by")
  reviewedAt    DateTime? @map("reviewed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([status, createdAt(sort: Desc)])
  @@map("ncf_moderation_cases")
}

model ModerationLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")    // null = SYSTEM
  actorType  String   @map("actor_type")  // user | system
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  reason     String?  @db.Text
  meta       Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([action, createdAt(sort: Desc)])
  @@map("ncf_moderation_log")
}

model InstalledPlugin {
  id               String    @id  // plugin manifest id e.g. "xentium-forum"
  name             String
  vendor           String
  installedVersion String    @map("installed_version")
  status           String    @default("installed")  // installed | enabled | disabled
  licenseRequired  Boolean   @default(false) @map("license_required")
  packagePath      String    @map("package_path")
  manifest         Json
  installedAt      DateTime  @default(now()) @map("installed_at")
  enabledAt        DateTime? @map("enabled_at")
  disabledAt       DateTime? @map("disabled_at")

  @@map("ncf_installed_plugins")
}

/// The current signed entitlement document for this install — NOT a licence.
///
/// The distinction is load-bearing and used to be lost in the name. The
/// marketplace issues one of these on every activation as a signed statement of
/// WHAT THIS ACCOUNT OWNS, and it issues one even when the answer is nothing.
/// While this was called `License`, the row's mere existence read as proof of a
/// licence: a freshly linked account that had bought nothing was shown
/// "Licensed until <date>", and the admin badge warned that a licence was
/// expiring when what was really approaching was the document's own 30-day
/// freshness window — which a healthy install refreshes every 7 days and never
/// reaches.
///
/// A LICENCE is a product entitlement held by an account on the marketplace,
/// with seats and an updates window; the instance reads those from
/// `/account/licenses` and never stores them. What lives here is the signed
/// paperwork that says which ones apply to this install, plus when it must be
/// re-fetched. `entitlements: []` inside the JWT is a perfectly ordinary state.
model Entitlement {
  id             String    @id @default(cuid())
  /// Display reference from the marketplace (e.g. "NDV-LBP7-4K2M") or
  /// "NVL-account". Never the licence key itself — the raw key never reaches an
  /// install, which is why calling this `licenseKey` was wrong twice over.
  licenseRef     String    @unique @map("license_ref")
  siteId         String    @map("site_id")
  entitlementJwt String    @db.Text @map("entitlement_jwt")
  status         String    @default("active")  // active | expired | deactivated
  activatedVia   String    @default("key") @map("activated_via") // key (manual/offline) | account (connected marketplace account)
  domain         String?                        // APP_URL host bound at activation (ADR 0001)
  environment    String?                        // production | staging | development (ADR 0001)
  activatedAt    DateTime  @default(now()) @map("activated_at")
  /// When the DOCUMENT stops being valid (+30d at issue). Not a subscription
  /// end date — see modules/admin/licenseAttention.ts before warning about it.
  expiresAt      DateTime? @map("expires_at")
  refreshAfter   DateTime? @map("refresh_after")

  @@map("ncf_entitlements")
}

model ErrorLog {
  id        String   @id @default(cuid())
  code      String
  message   String   @db.Text
  context   Json?
  severity  String   // info | warn | error | critical
  requestId String?  @map("request_id")
  userId    String?  @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([severity, createdAt(sort: Desc)])
  @@map("ncf_error_log")
}

model StyleHistory {
  id        String   @id @default(cuid())
  label     String
  tokens    Json
  savedById String   @map("saved_by_id")
  createdAt DateTime @default(now()) @map("created_at")

  savedBy User @relation(fields: [savedById], references: [id], onDelete: Cascade)

  @@map("ncf_style_history")
}

model InviteCode {
  id        String    @id @default(cuid())
  code      String    @unique
  note      String?                         // admin note (e.g. "for alice")
  createdById String  @map("created_by_id")
  usedById  String?   @map("used_by_id")
  usedAt    DateTime? @map("used_at")
  expiresAt DateTime? @map("expires_at")   // null = never expires
  maxUses   Int       @default(1) @map("max_uses")
  useCount  Int       @default(0) @map("use_count")
  createdAt DateTime  @default(now()) @map("created_at")

  createdBy User  @relation("InviteCreated", fields: [createdById], references: [id], onDelete: Cascade)
  usedByUser User? @relation("InviteUsed",   fields: [usedById],   references: [id], onDelete: SetNull)

  @@index([code])
  @@map("ncf_invite_codes")
}

// BetaCode / BetaAccessLog lived here. The beta gate is a plugin now
// (`xentium-launch`), which owns `launch_codes` and `launch_access_log`; its
// install migration copies any rows these tables still held. Core keeps no
// schema for a feature it no longer has an opinion about.

model NavItem {
  id               String   @id @default(cuid())
  label            String
  url              String
  position         Int      @default(0)
  parentId         String?  @map("parent_id")
  isActive         Boolean  @default(true) @map("is_active")
  isSystem         Boolean  @default(false) @map("is_system")
  pluginId         String?  @map("plugin_id")   // set when registered by a plugin
  // Where the link renders: 'navbar' (top nav) or 'footer'. Default navbar so
  // existing items are unaffected.
  placement        String   @default("navbar")
  // Set when this item links to a custom Page (§page-system). URL derives from the
  // page slug; the item auto-deactivates when the page is unpublished or deleted.
  pageId           String?  @map("page_id")
  page             Page?    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  openInNewTab     Boolean  @default(false) @map("open_in_new_tab")
  visibility       String   @default("public")
  visibilityGroups String[] @default([]) @map("visibility_groups")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([parentId, position])
  @@index([pageId])
  @@map("ncf_nav_items")
}

// Custom static page (TOS, privacy, imprint, about, …). A page is strictly a
// title + TipTap body rendered inside the normal AppLayout at /p/:slug — NOT
// layout/template work. Kept as its own entity (not articles.type='page') so it
// never pollutes article queries/feeds/comments.
model Page {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  body           Json      // TipTap / ProseMirror JSON — never raw HTML (§17b)
  featuredImage  String?   @map("featured_image") // header image storage path
  status         String    @default("draft")   // 'draft' | 'published'
  visibility     String    @default("public")  // 'public' | 'members'
  seoDescription String?   @map("seo_description") @db.Text
  createdById    String?   @map("created_by_id")
  createdBy      User?     @relation("PageCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  publishedAt    DateTime? @map("published_at")
  navItems       NavItem[]
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@map("ncf_pages")
}

// Unified activity log: public page movements (category 'page_visit') AND ACP
// usage/actions (category 'acp_action'). Viewed in ACP → System → Activity Log.
model ActivityLog {
  id        String   @id @default(cuid())
  category  String   // 'page_visit' | 'acp_action'
  userId    String?  @map("user_id")
  username  String?
  method    String?  // HTTP method (acp_action)
  path      String   // visited URL or admin API path
  status    Int?     // response status (acp_action)
  ip        String?
  userAgent String?  @map("user_agent")
  meta      Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([category, createdAt(sort: Desc)])
  @@index([userId])
  @@map("ncf_activity_log")
}

// Last ACP page visit per user per path. DURABLE acknowledgment state for the
// per-admin ACP-entry dialogs (updates / license expiry): "acknowledged" =
// lastVisitAt >= the signal's anchor. Kept separate from ncf_activity_log on
// purpose — the activity log is prunable telemetry (log-retention job), while
// this table is bounded (users × paths) and must survive pruning, otherwise
// retention would silently un-acknowledge dialogs.
model AcpVisit {
  userId      String   @map("user_id")
  path        String
  lastVisitAt DateTime @map("last_visit_at")

  @@id([userId, path])
  @@map("ncf_acp_visits")
}

// ── Phase 14: Plugin migrations ───────────────────────────────────────────────

model XentiumPluginMigration {
  id        String   @id                      // "{pluginId}_{ver}_{name}"
  pluginId  String   @map("plugin_id")
  pluginVer String   @map("plugin_ver")
  name      String
  appliedAt DateTime @default(now()) @map("applied_at")
  checksum  String                            // SHA-256 of migration SQL
  direction String                            // 'up' | 'down'

  @@index([pluginId])
  @@map("ncf_plugin_migrations")
}


// Reviewed security signals — device cookies / IPs that a mod has cleared.
// The security analysis job skips case creation for these but still logs every match.
model ReviewedSecuritySignal {
  id              String   @id @default(cuid())
  signalType      String   @map("signal_type")        // 'device_cookie' | 'ip'
  signalValue     String   @map("signal_value")
  caseId          String   @map("case_id")
  reviewedBy      String   @map("reviewed_by")
  reviewedAt      DateTime @default(now()) @map("reviewed_at")
  clearedUserIds  String[] @default([]) @map("cleared_user_ids")

  @@unique([signalType, signalValue])
  @@index([signalType, signalValue])
  @@map("ncf_reviewed_security_signals")
}

// ── Block layout composition (ADR-0005) ──────────────────────────────────────
// A page's structure is a DOCUMENT, not code: blocks per named region, per
// template. Two rows per template at most — the `draft` an admin is editing and
// the `published` one the site serves — reusing the appearance draft→publish
// model rather than inventing a second staging path.
//
// No row is required: a template with nothing stored renders DEFAULT_LAYOUTS
// from @xentium/contracts, which is also what "Reset to default" restores by
// deleting rows. A template is never without a renderable document.
model Layout {
  id            String   @id @default(cuid())
  templateKey   String   @map("template_key")  // TemplateKey — a fixed enum in contracts
  /// '' = the template default; otherwise the variant key (a page slug for
  /// `page.detail`). NOT NULL and '' rather than nullable, because Postgres treats
  /// NULLs as DISTINCT in a unique index — a nullable column would admit two rows
  /// for (template_key, NULL, scope), the duplicate the constraint exists to stop.
  variant       String   @default("")
  scope         String                          // 'draft' | 'published'
  document      Json                            // LayoutDocument
  schemaVersion Int      @default(1) @map("schema_version") // migration state, queryable
  updatedById   String?  @map("updated_by_id")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([templateKey, variant, scope])
  @@index([scope, templateKey])
  @@map("ncf_layouts")
}

// ── Admin-created scheduled tasks ────────────────────────────────────────────
// The predefined jobs in SCHEDULED_JOBS are code-owned: an admin can only change
// WHEN they run. These rows are the admin-composed ones — an action key from the
// core action registry + validated params + a schedule. Core executes only
// registered handlers; there is no arbitrary code path.
//
// Plugin cron jobs are deliberately NOT here: a plugin owns its own schedules
// end to end (it calls upsertJobScheduler itself from onEnable), so a task can
// never reference a handler that disappears with a plugin.
model ScheduledTask {
  id          String    @id @default(cuid())
  name        String
  actionKey   String    @map("action_key")     // key in the core action registry
  params      Json      @default("{}")         // validated against the action's Zod schema
  schedule    Json                             // JobScheduleConfig (mode/interval/daily/cron/tz)
  enabled     Boolean   @default(true)
  dryRun      Boolean   @default(false) @map("dry_run")  // report, never write

  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Denormalized last-run summary so the ACP list needs no per-row subquery.
  lastRunAt   DateTime? @map("last_run_at")
  lastStatus  String?   @map("last_status")    // 'running' | 'ok' | 'error' | 'skipped'

  runs        ScheduledTaskRun[]

  @@index([enabled])
  @@map("ncf_scheduled_tasks")
}

// Per-run history. Pruned by the existing log-retention job (retention.task_runs_days)
// rather than owning a cleanup path of its own.
model ScheduledTaskRun {
  id         String        @id @default(cuid())
  taskId     String        @map("task_id")
  task       ScheduledTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  startedAt  DateTime      @default(now()) @map("started_at")
  finishedAt DateTime?     @map("finished_at")
  durationMs Int?          @map("duration_ms")
  // Written as 'running' when the row is created, then settled by the runner.
  status     String                                 // 'running' | 'ok' | 'error' | 'skipped'
  dryRun     Boolean       @default(false) @map("dry_run")
  summary    String?       @db.Text                 // human-readable outcome
  error      String?       @db.Text

  @@index([taskId, startedAt])
  @@map("ncf_scheduled_task_runs")
}
