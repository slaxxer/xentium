{
  "name": "@xentium/migrate-woltlab",
  "version": "1.0.0-alpha.14",
  "private": true,
  "description": "WoltLab Suite (Burning Board 4 and 5, WoltLab Suite 5 and 6) → Xentium migration adapter. Connects directly to the WoltLab MySQL database. Requires the xentium-forum plugin on the target.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run",
    "migrate": "tsx src/run.ts"
  },
  "dependencies": {
    "@xentium/migrate-core": "workspace:*",
    "mysql2": "^3.24.5"
  },
  "devDependencies": {
    "@xentium/config": "workspace:*",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
