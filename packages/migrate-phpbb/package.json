{
  "name": "@nodevo/migrate-phpbb",
  "version": "1.0.0-alpha.0",
  "private": true,
  "description": "phpBB 3.1+ → Nodevo migration adapter (§34, Wave 1). Connects directly to the phpBB MySQL database. Requires the nodevo-forum plugin on the target.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run",
    "migrate": "tsx src/run.ts"
  },
  "dependencies": {
    "@nodevo/migrate-core": "workspace:*",
    "htmlparser2": "^10.1.0",
    "mysql2": "^3.16.0"
  },
  "devDependencies": {
    "@nodevo/config": "workspace:*",
    "tsx": "^4.22.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
