{
  "name": "@xentium/contracts",
  "version": "1.0.0-alpha.15",
  "private": false,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "devDependencies": {
    "@xentium/config": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "description": "Shared types, constants and XEC error codes for the Xentium framework.",
  "license": "MIT",
  "author": "Xentium",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slaxxer/xentium.git",
    "directory": "packages/contracts"
  },
  "homepage": "https://github.com/slaxxer/xentium/tree/main/packages/contracts#readme",
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
