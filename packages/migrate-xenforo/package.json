{
  "name": "@xentium/migrate-xenforo",
  "version": "1.0.0-alpha.15",
  "private": true,
  "description": "XenForo 2.x → Xentium migration adapter (§34, Wave 1). Connects directly to the XenForo MySQL database. Requires the xentium-forum plugin on the target.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run",
    "migrate": "tsx src/run.ts"
  },
  "dependencies": {
    "@xentium/migrate-core": "workspace:*",
    "mysql2": "^3.24.5"
  },
  "devDependencies": {
    "@xentium/config": "workspace:*",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
