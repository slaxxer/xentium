{
  "name": "@xentium/migrate-wp",
  "version": "1.0.0-rc.2",
  "private": true,
  "description": "WordPress → Xentium migration adapter (§34, Wave 1). Consumes a WXR export file — no WordPress installation or database access needed.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run",
    "migrate": "tsx src/run.ts"
  },
  "dependencies": {
    "@xentium/migrate-core": "workspace:*",
    "fast-xml-parser": "^5.11.2"
  },
  "devDependencies": {
    "@xentium/config": "workspace:*",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
