{
  "name": "@nodevo/server-kit",
  "version": "1.0.0-alpha.1",
  "private": false,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@nodevo/contracts": "workspace:*",
    "@nodevo/errors": "workspace:*"
  },
  "peerDependencies": {
    "express": "catalog:",
    "express-rate-limit": "catalog:",
    "file-type": "^22.0.1",
    "multer": "catalog:",
    "rate-limit-redis": "^5.0.0"
  },
  "devDependencies": {
    "@nodevo/config": "workspace:*",
    "@types/express": "^5",
    "@types/multer": "^2",
    "express": "catalog:",
    "express-rate-limit": "catalog:",
    "file-type": "^22.0.1",
    "multer": "catalog:",
    "rate-limit-redis": "^5.0.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "description": "Server utilities for Xentium-framework applications: settings, pagination, secrets, rate limiting, uploads, storage.",
  "license": "MIT",
  "author": "Xentium",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slaxxer/nodevo.git",
    "directory": "packages/server-kit"
  },
  "homepage": "https://github.com/slaxxer/nodevo/tree/main/packages/server-kit#readme",
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
