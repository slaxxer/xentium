{
  "name": "xentium",
  "version": "1.0.0-alpha.4",
  "description": "Install, run, check and update a Xentium site. Start with `npm create xentium`.",
  "license": "MIT",
  "author": "Xentium",
  "type": "module",
  "bin": {
    "xentium": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@types/pg": "^8",
    "@xentium/config": "workspace:*",
    "tsup": "^8",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slaxxer/xentium.git",
    "directory": "packages/cli"
  },
  "homepage": "https://doc.xentium.org",
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
