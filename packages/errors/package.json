{
  "name": "@nodevo/errors",
  "version": "1.0.0-alpha.0",
  "private": false,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "peerDependencies": {
    "express": "catalog:",
    "zod": "catalog:"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nodevo/config": "workspace:*",
    "@types/express": "^5",
    "express": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@nodevo/contracts": "workspace:*",
    "zod": "catalog:"
  },
  "description": "NodevoError, the NEC code registry, and the Express error middleware.",
  "license": "MIT",
  "author": "Nodevo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slaxxer/nodevo.git",
    "directory": "packages/errors"
  },
  "homepage": "https://github.com/slaxxer/nodevo/tree/main/packages/errors#readme",
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
