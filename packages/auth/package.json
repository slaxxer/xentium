{
  "name": "@xentium/auth",
  "version": "1.0.0-alpha.19",
  "private": false,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@xentium/contracts": "workspace:*",
    "@xentium/errors": "workspace:*",
    "argon2": "catalog:",
    "bcryptjs": "^3.0.3",
    "jose": "catalog:"
  },
  "peerDependencies": {
    "express": "catalog:"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@xentium/config": "workspace:*",
    "express": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "description": "Authentication primitives: token minting and verification, password hashing, access-token revocation, request guards.",
  "license": "MIT",
  "author": "Xentium",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slaxxer/xentium.git",
    "directory": "packages/auth"
  },
  "homepage": "https://github.com/slaxxer/xentium/tree/main/packages/auth#readme",
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
