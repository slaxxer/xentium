{
  "name": "@xentium/plugin-engine",
  "version": "1.0.0-alpha.6",
  "private": false,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@xentium/contracts": "workspace:*",
    "@xentium/errors": "workspace:*",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "express": "catalog:"
  },
  "devDependencies": {
    "@xentium/config": "workspace:*",
    "@types/express": "^5",
    "express": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "description": "Plugin manifest validation, the DDL-only migration SQL guard, and the plugin registry and router.",
  "license": "MIT",
  "author": "Xentium",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slaxxer/xentium.git",
    "directory": "packages/plugin-engine"
  },
  "homepage": "https://github.com/slaxxer/xentium/tree/main/packages/plugin-engine#readme",
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
