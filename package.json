{
  "name": "xentium-monorepo",
  "version": "1.0.0-alpha.7",
  "private": true,
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=22.12"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "backbone:up": "docker compose --env-file .env -f docker/docker-compose.yml up -d",
    "backbone:down": "docker compose --env-file .env -f docker/docker-compose.yml down",
    "backbone:check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "dev:apps": "concurrently -k -n api,worker,web -c green,yellow,cyan \"pnpm --filter @xentium/api dev\" \"pnpm --filter @xentium/api dev:worker\" \"pnpm --filter @xentium/web dev\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "plugin:package": "node scripts/package-plugin.mjs",
    "release": "node scripts/publish-release.mjs",
    "release:dry": "node scripts/publish-release.mjs --dry-run",
    "release:framework": "node scripts/release-framework.mjs",
    "release:framework:dry": "node scripts/release-framework.mjs --dry-run",
    "e2e:reset": "prisma migrate reset --force",
    "e2e": "pnpm e2e:reset && pnpm --filter @xentium/e2e run e2e",
    "e2e:ui": "pnpm e2e:reset && pnpm --filter @xentium/e2e run e2e:ui",
    "pack:server": "node scripts/pack-server.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^24",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "prettier": "^3",
    "prisma": "catalog:",
    "turbo": "^2",
    "typescript": "catalog:",
    "typescript-eslint": "^8"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "@prisma/engines",
      "prisma",
      "msgpackr-extract",
      "esbuild",
      "@parcel/watcher"
    ]
  }
}
