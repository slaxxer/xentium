# Shared pnpm config. This file is COMMITTED.
#
# NEVER put a registry token here — `_authToken` in a tracked file is a token in
# the repo. Tokens belong in ~/.npmrc (user-level, never committed):
#   npm config set //registry.npmjs.org/:_authToken <token>
# or in CI, an environment secret.

auto-install-peers=true
strict-peer-dependencies=false
