# Shared pnpm config. This file is COMMITTED.
#
# NEVER put a registry token here — `_authToken` in a tracked file is a token in
# the repo. Tokens belong in ~/.npmrc (user-level, never committed), or in CI as
# an environment secret.
#
# ⚠ `npm config set` WRITES HERE, not to ~/.npmrc, whenever it is run from
#   inside the repo. It will also strip these comments. Always pass the location:
#
#     npm config set --location=user //registry.npmjs.org/:_authToken <token>
#
#   Getting this wrong puts a live token in a tracked file, which is how one
#   ends up committed.

auto-install-peers=true
strict-peer-dependencies=false
